{
  "name": "playwright-ai-framework",
  "version": "1.0.0",
  "description": "Playwright Automation Framework with POM and fixtures",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:allure": "npm test && npm run allure:generate",
    "allure:generate": "node scripts/generate-allure-report.js",
    "allure:open": "node scripts/open-latest-allure-report.js",
    "allure:report": "node scripts/generate-allure-report.js && node scripts/open-latest-allure-report.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^6.0.3",
    "winston": "^3.19.0"
  }
}
